# Copy to .env.local (never commit it). These are PUBLIC Firebase web-app settings, not secrets, but they
# are kept out of the repo so each deployment can use its own project. Leave them empty to run offline/local-only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
